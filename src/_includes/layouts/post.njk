---
layout: layouts/base.njk
---
<article class="post">
  <header class="post__header">
    <p class="post__meta">{{ date | readableDate }}{% if tags %}{% for tag in tags %}{% if tag != "post" %} · {{ tag }}{% endif %}{% endfor %}{% endif %}</p>
    <h1 class="post__title">{{ title }}</h1>
    {% if excerpt %}<p class="post__excerpt">{{ excerpt }}</p>{% endif %}
  </header>

  <div class="post__body">
    {{ content | safe }}
  </div>

  <p class="post__back"><a href="/">&larr; Back to all posts</a></p>
</article>
